# =============================================================================
# SIS-CHAVE — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env (local) ou .env.homolog (VM) e preencha os
# valores reais. NUNCA commite arquivos .env com valores reais.
# =============================================================================

# ── Banco de Dados ────────────────────────────────────────────────────────────
DB_USER=sischave
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=sischave
DB_PORT_LOCAL=5432
DB_PORT_CONTAINER=5432

# ── Django ────────────────────────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# True apenas em desenvolvimento local — nunca em servidor
DJANGO_DEBUG=False

# ── CORS ──────────────────────────────────────────────────────────────────────
# True apenas em desenvolvimento local — nunca em servidor
CORS_ALLOW_ALL=False
# Ex: http://192.168.1.50 ou https://sischave.suaempresa.gov.br
CORS_ALLOWED_ORIGINS=http://SEU_IP_OU_DOMINIO

# ── Hosts permitidos ──────────────────────────────────────────────────────────
ALLOWED_HOSTS=SEU_IP_OU_DOMINIO

# ── Usuário administrador inicial ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Frontend ──────────────────────────────────────────────────────────────────
# Deixe vazio para URLs relativas via proxy nginx (recomendado em servidor)
# Use http://localhost:8080 apenas para desenvolvimento local sem nginx
VITE_API_URL=

# ── Deploy via Pipeline (apenas no .env.homolog da VM) ───────────────────────
# URL base do Container Registry do GitLab
BACKEND_IMAGE=registry.gitlab.com/SEU_GRUPO/sischave/backend
FRONTEND_IMAGE=registry.gitlab.com/SEU_GRUPO/sischave/frontend
# IMAGE_TAG é injetado pela pipeline via export — não precisa definir aqui
